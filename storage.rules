rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Android APK releases: public read for downloading published releases, authenticated write/delete
    match /apps/android/releases/{releaseId}/{fileName} {
      allow read: if true;
      allow write, delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
