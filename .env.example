# ==========================================
# SBG MUSIC Environment Variables Configuration
# ==========================================

# Server-side Gemini API key (Server-only, do NOT expose in frontend)
GEMINI_API_KEY=""

# Server-side YouTube Data API v3 Key (Server-only, used for YouTube import API)
YOUTUBE_API_KEY=""

# Public Application Canonical Site URL
SITE_URL="https://sbg-song.vercel.app"
APP_URL="https://sbg-song.vercel.app"

# Node Environment
NODE_ENV="production"
